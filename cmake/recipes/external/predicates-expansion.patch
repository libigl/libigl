+/* Expansion arithmetic. Call exactinit() before using these routines.
+ * Arithmetic must round to nearest; intermediate overflow/underflow is not
+ * supported. The scalar transforms return a rounded value and its exact tail.
+ * Expansion inputs are nonempty, strongly nonoverlapping, and ordered from
+ * smallest to largest magnitude. Output buffers must not alias either input.
+ * Sum requires elen + flen output entries; scale requires 2 * elen entries.
+ * Both return the number of output entries, including one zero for exact zero.
+ */
+void predicates_two_sum(IGL_PREDICATES_REAL a, IGL_PREDICATES_REAL b,
+                       IGL_PREDICATES_REAL *value, IGL_PREDICATES_REAL *tail);
+void predicates_two_diff(IGL_PREDICATES_REAL a, IGL_PREDICATES_REAL b,
+                        IGL_PREDICATES_REAL *value, IGL_PREDICATES_REAL *tail);
+void predicates_two_product(IGL_PREDICATES_REAL a, IGL_PREDICATES_REAL b,
+                           IGL_PREDICATES_REAL *value, IGL_PREDICATES_REAL *tail);
+int predicates_expansion_sum(int elen, const IGL_PREDICATES_REAL *e,
+                             int flen, const IGL_PREDICATES_REAL *f,
+                             IGL_PREDICATES_REAL *h);
+int predicates_expansion_scale(int elen, const IGL_PREDICATES_REAL *e,
+                               IGL_PREDICATES_REAL b, IGL_PREDICATES_REAL *h);
+
 #ifdef __cplusplus
 }
 #endif
