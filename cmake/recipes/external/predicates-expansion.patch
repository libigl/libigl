+/* Public wrappers around the existing error-free transforms and expansion
+ * routines. Keep the arithmetic in the original implementation above. */
+void predicates_two_sum(REAL a, REAL b, REAL *value, REAL *tail)
+{
+  REAL x, y, bvirt, avirt, bround, around;
+  Two_Sum(a, b, x, y);
+  *value = x;
+  *tail = y;
+}
+
+void predicates_two_diff(REAL a, REAL b, REAL *value, REAL *tail)
+{
+  REAL x, y, bvirt, avirt, bround, around;
+  Two_Diff(a, b, x, y);
+  *value = x;
+  *tail = y;
+}
+
+void predicates_two_product(REAL a, REAL b, REAL *value, REAL *tail)
+{
+  REAL x, y, c, abig, ahi, alo, bhi, blo, err1, err2, err3;
+  Two_Product(a, b, x, y);
+  *value = x;
+  *tail = y;
+}
+
+int predicates_expansion_sum(int elen, const REAL *e, int flen,
+                             const REAL *f, REAL *h)
+{
+  return fast_expansion_sum_zeroelim(elen, e, flen, f, h);
+}
+
+int predicates_expansion_scale(int elen, const REAL *e, REAL b, REAL *h)
+{
+  return scale_expansion_zeroelim(elen, e, b, h);
+}
