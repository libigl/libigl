@@ -10,6 +10,13 @@ endif()

 add_library(${PROJECT_NAME} predicates.c predicates.h)

+# Error-free transforms require the written sequence of rounded operations.
+if(MSVC)
+    target_compile_options(${PROJECT_NAME} PRIVATE /fp:strict)
+elseif(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
+    target_compile_options(${PROJECT_NAME} PRIVATE -fno-fast-math -ffp-contract=off)
+endif()
+
 include(GNUInstallDirs)
 target_include_directories(${PROJECT_NAME} PUBLIC
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
